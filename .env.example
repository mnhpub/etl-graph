# PostgreSQL connection for Instagres
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/etl_graph

# Enable SSL for production Instagres connections
DATABASE_SSL=false

# ETL data source API endpoint
ETL_API_ENDPOINT=https://jsonplaceholder.typicode.com/posts

# API server port
PORT=3001
